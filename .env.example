# Copy this file to .env and fill in your own values.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env is gitignored - never commit real keys.

# --- STT + LLM provider keys ---
# You only need the key for the provider you select below.
# Whisper STT specifically needs OPENAI_API_KEY; without it, STT falls back
# to the free SpeechRecognition/Google engine.
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Which LLM generates conversation replies: "openai" or "anthropic"
LLM_PROVIDER=openai

# --- Model overrides (optional) ---
# OPENAI_LLM_MODEL=gpt-4o-mini
# ANTHROPIC_LLM_MODEL=claude-opus-5      # claude-haiku-4-5 for lower call latency
# WHISPER_MODEL=whisper-1

# Language pinned on every Whisper request (ISO-639-1). Leave as "en" unless
# your callers speak another language - with auto-detection Whisper will
# transcribe English speech into Tamil, Hindi or Chinese script on noisy audio.
STT_LANGUAGE=en

# --- Twilio (only needed once you connect a real phone number) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Public URL Twilio will call back into (use your ngrok URL while testing)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# How long Twilio's <Record> listens before giving up
# RECORD_TIMEOUT_SECONDS=3
# RECORD_MAX_LENGTH_SECONDS=20

# --- Pharmacy / knowledge base ---
PHARMACY_NAME=GreenLeaf Pharmacy

# Minimum fuzzy-match confidence before a spoken word is accepted as a medicine
# name. Lower it if your STT mangles names badly; raise it if the agent guesses
# wrong medicines.
KB_MATCH_THRESHOLD=0.62

# --- Input limits (Week 4) ---
# A phone turn is a sentence or two; anything past this is truncated (voice) or
# refused (HTTP), so one oversized request cannot tie up a worker thread.
# MAX_QUERY_CHARS=500
# MAX_QUERY_TOKENS=60
# Largest pack count a caller can order without a pharmacist. Above this the
# quantity is re-asked rather than passed straight to the stock check.
# MAX_ORDER_QUANTITY=50

# --- Security (Week 4) ---
# Required by /orders, /escalations, /kb/* and /query/analyze - sent back as
# the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Endpoints refuse every request (503) until this is set - never left open by
# default.
ADMIN_API_KEY=

# Local-demo escape hatch that removes the X-API-Key requirement entirely.
# Never set this anywhere reachable from a network.
# DISABLE_AUTH=false

# Verifies X-Twilio-Signature on /voice/* against TWILIO_AUTH_TOKEN, so a
# stranger who finds the public URL cannot inject a fake call. On by default;
# needs a real TWILIO_AUTH_TOKEN and PUBLIC_BASE_URL once you connect a number.
# VALIDATE_TWILIO_SIGNATURE=true

# --- Call session lifecycle (Week 4) ---
# A dropped call with no final Twilio callback is evicted after this many
# idle seconds, and the active-session count is capped, so memory cannot grow
# without bound.
# SESSION_TTL_SECONDS=1800
# MAX_ACTIVE_SESSIONS=500

# --- Outbound call timeouts (Week 4) ---
# Every network call this process makes is bounded, so a slow provider cannot
# hold a phone line - or a worker thread - open indefinitely.
# LLM_TIMEOUT_SECONDS=20
# STT_TIMEOUT_SECONDS=30
# TWILIO_DOWNLOAD_TIMEOUT_SECONDS=15

# --- Persistence (Week 4) ---
# Seconds to wait for the cross-process write lock on data/orders.json and
# data/escalations.json before giving up.
# STORE_LOCK_TIMEOUT_SECONDS=10
